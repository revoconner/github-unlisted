# GitHub App (server-only). From github.com → Settings → Developer settings → GitHub Apps.
GITHUB_APP_ID=
# Paste the full PEM with newlines escaped as \n on a single line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Public app slug (the part in github.com/apps/<slug>), used for the install link.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# GitLab (server-only). From gitlab.com → Settings → Applications → Manage OAuth2 applications → Create a new OAuth2 application → Insert an Application name (e.g. GitLabGithubUnlisted) → Insert the callback URI to: https://www.github-unlisted.com/api/forge/callback → Make sure to tick "Confidential client" checkbox.
GITLAB_APP_CLIENT_ID=
GITLAB_APP_CLIENT_SECRET=

# Gitee (server-only). From gitee.com → Settings → Applications → Manage OAuth2 applications → Create a new OAuth2 application → Insert an Application name (e.g. GiteeGithubUnlisted) → Insert the callback URI to: https://www.github-unlisted.com/api/forge/callback → Make sure to tick "Confidential client" checkbox.
GITEE_APP_CLIENT_ID=
GITEE_APP_CLIENT_SECRET=

# Gitea (server-only). From gitea.com → Settings → Applications → Manage OAuth2 applications → Create a new OAuth2 application → Insert an Application name (e.g. GiteaGithubUnlisted) → Insert the callback URI to: https://www.github-unlisted.com/api/forge/callback → Make sure to tick "Confidential client" checkbox.
GITEA_APP_CLIENT_ID=
GITEA_APP_CLIENT_SECRET=

# Codeberg (server-only). From codeberg.org → Settings → Applications → Manage OAuth2 applications → Create a new OAuth2 application → Insert an Application name (e.g. CodebergGithubUnlisted) → Insert the callback URI to: https://www.github-unlisted.com/api/forge/callback → Make sure to tick "Confidential client" checkbox.
CODEBERG_APP_CLIENT_ID=
CODEBERG_APP_CLIENT_SECRET=

# Random secret used to sign the owner login cookie. Generate any long random
# string (e.g. two GUIDs concatenated). Required.
SESSION_SECRET=

# Upstash Redis via the Vercel Marketplace integration (KV_* names) — or the
# native Upstash names. The read-only KV token cannot write; use the RW one.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: expire share links after N seconds (unset = never).
SHARE_LINK_TTL_SECONDS=

# Resend (contact form). API key from resend.com; the sending domain must be
# verified there. Added on Vercel via the Resend integration. Required for the
# contact form to send.
RESEND_API_KEY=
# Optional: override the contact form's to/from addresses. Defaults are
# github-unlisted@revoconner.com and "Unlisted Repo <contact@revoconner.com>".
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Self-hosted OAuth client secrets are supplied by the user and encrypted
# server-side while an OAuth authorization is pending. They are not stored in
# environment variables.
